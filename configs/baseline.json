{
  "experiment_name": "baseline",
  "model": {
    "vocab_size": 16000,
    "pad_token_id": 0,
    "d_model": 512,
    "n_layers": 6,
    "n_heads": 8,
    "d_ff": 2048,
    "max_seq_len": 256,
    "dropout": 0.1,
    "n_diffusion_steps": 8,
    "precision_schedule": [16, 16, 16, 16, 16, 16, 16, 16],
    "model_type": "baseline"
  },
  "data": {
    "dataset_name": "wikimedia/wikipedia",
    "dataset_config": "20231101.en",
    "max_articles": 50000,
    "max_text_bytes": 500000000,
    "seq_len": 256,
    "tokenizer_path": "tokenizer/wiki_bpe",
    "data_cache_dir": "data/cache",
    "train_split": 0.95
  },
  "train": {
    "batch_size": 8,
    "learning_rate": 3e-4,
    "weight_decay": 0.01,
    "max_steps": 10000,
    "warmup_steps": 500,
    "grad_clip": 1.0,
    "checkpoint_dir": "checkpoints",
    "checkpoint_every": 500,
    "resume_from": null,
    "eval_every": 250,
    "eval_steps": 50,
    "log_every": 10,
    "seed": 42
  }
}
